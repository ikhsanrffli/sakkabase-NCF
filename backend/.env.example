# Salin file ini menjadi .env lalu isi nilai yang sesuai
# cp .env.example .env

# Database MySQL (XAMPP default: user=root, password kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sakkabase_ncf

# JWT — ganti dengan string acak panjang sebelum production
JWT_SECRET=ganti_dengan_secret_yang_kuat_minimal_32_karakter
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Path ke file model NCF (relatif dari folder backend/)
MODEL_PATH=../models/ncf_config_B.pth
